<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mac Mini Cockpit</title>
<style>
  :root {
    --bg: #0a0b10;
    --card-bg: #14161e;
    --border: #232732;
    --text-main: #e6e8f0;
    --text-dim: #8b90a5;
    --accent: #4f9cf9;
    --success: #3ddc84;
    --warning: #f5c542;
    --danger: #ff5c6c;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background-color: var(--bg);
    color: var(--text-main);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    padding: 2rem;
  }

  header {
    width: 100%;
    max-width: 1200px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: rem;
  }

  .brand { display: flex; align-items: center; gap: 12px; }
  .brand h1 { font-size: 1.5rem; letter-spacing: -0.5px; }
  .status-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--border); }
  .status-dot.online { background: var(--success); box-shadow: 0 0 10px var(--success); }

  .meta { text-align: right; color: var(--text-dim); font-size: 0.9rem; }

  /* Grid Layout */
  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    width: 100%;
    max-width: 1200px;
  }

  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  /* Large Stats Card (Full Width spanning) */
  .card-hero { grid-column: span 2; display: flex; justify-content: space-between; align-items: center; }
  @media (max-width: 800px) { .card-hero { grid-column: span 1; } }

  .card h2 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin-bottom: 1rem;
  }

  .stat-main { font-size: 2.5rem; font-weight: 700; margin-bottom: 0.5rem; }
  .stat-sub { font-size: 1rem; color: var(--text-dim); }

  .progress-container {
    width: 100%;
    height: 6px;
    background: var(--border);
    border-radius: 3px;
    margin-top: auto;
    overflow: hidden;
  }
  .progress-bar { height: s100%; width: 0; transition: width 1s ease-in-out, background-color 0.5s; }

  /* Section: AI/Gemma */
  .card-ai { border-left: 4px solid var(--accent); }
  .ai-action { font-size: 1.2rem; font-weight: 600; color: var(--accent); margin-bottom: 4px; }
  .ai-meta { font-size: 0.85rem; opacity: 0.7; }

  /* Section: Guard */
  .card-guard { border-left: 4px solid var(--warning); }
  .process-list { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.85rem; }
  .process-list th { text-align: left; color: var(--text-dim); padding: 8px; font-weight: 500; }
  .process-list td { padding: 8px; border-bottom: 1px solid var(--border); }
  .process-row-heavy { color: var(--danger); font-weight: 600; }

  .footer { margin-top: 2rem; color: var(--text-dim); font-size: 0.8rem; text-align: center; opacity: 0.5; }

  .modus-schalter { display: flex; gap: 6px; margin-top: 10px; }
  .modus-schalter button {
    flex: 1; padding: 5px 0; font-size: 12px; cursor: pointer;
    border: 1px solid var(--border); border-radius: 7px;
    background: var(--bg); color: var(--text-main);
  }
  .modus-schalter button.on { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
  .gbtn {
    padding: 2px 8px; font-size: 11px; border-radius: 6px; cursor: pointer; margin-right: 3px;
    border: 1px solid var(--border); background: var(--bg); color: var(--text-main);
  }
  .gbtn:hover { border-color: var(--accent); }
  .gbtn.stop { color: var(--danger); }
  .cmd { max-width: 340px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-dim); }

</style>
</head>
<body>

<header>
  <div class="brand">
    <div id="status-dot" class="status-dot"></div>
    <h1>Mac Mini <span style="font-weight: 300;">Cockpit</span></h1>
  </div>
  <div class="meta">
    <span id="hostname">–</span> · <span id="zeit">–</span>
  </div>
</header>

<div class="dashboard-grid">
  <!-- CPU -->
  <div class="card">
    <h2>CPU Load</h2>
    <div class="stat-main"><span id="cpu">–</span>%</div>
    <div class="stat-sub"><span id="kerne">–</span> Cores · <span id="last">–</span></div>
    <div class="progress-container"><div id="cpu-bar" class="progress-bar"></div></div>
  </div>

  <!-- RAM -->
  <div class="card">
    <h2>Memory (RAM)</h2>
    <div class="stat-main"><span id="ram-proz">–</span>%</div>
    <div class="stat-sub"><span id="ram-werte">–</span> GB used</div>
    <div class="progress-container"><div id="ram-bar" class="progress-bar"></div></div>
  </div>

  <!-- Disk -->
  <div class="card">
    <h2>Storage</h2>
    <div class="stat-main"><span id="disk-proz">–</span>%</div>
    <div class="stat-sub"><span id="disk-werte">–</span> Free / <span id="disk-gesamt">–</span> GB</div>
    <div class="progress-container"><div id="disk-bar" class="progress-bar"></div></div>
  </div>

  <!-- Thermal -->
  <div class="card">
    <h2>Thermal Status</h2>
    <div class="stat-main"><span id="temp-val">–</span>°C</div>
    <div class="stat-sub">Limit: <span id="thermal-limit">–</span>%</div>
    <div class="progress-container"><div id="thermal-bar" class="progress-bar"></div></div>
  </div>

  <!-- AI / Gemma (Hero Style) -->
  <div class="card card-ai">
    <h2>AI Intelligence</h2>
    <div id="gemma-action" class="ai-action">–</div>
    <div id="gemma-detail" class="stat-sub">–</div>
    <div id="gemma-meta" class="ai-meta">–</div>
  </div>

  <!-- Uptime -->
  <div classs="card">
    <h2>System Uptime</h2>
    <div class="stat-main" id="uptime">–</div>
    <div class="stat-sub">Since last boot</div>
  </div>

  <!-- Guard-Zustand -->
  <div class="card card-guard">
    <h2>mini-guard <span id="guard-punkt" class="status-dot" style="display:inline-block"></span></h2>
    <div id="guard-main" class="ai-action" style="color: var(--warning);">–</div>
    <div id="guard-detail" class="stat-sub">–</div>
    <div class="modus-schalter" id="guard-modus">
      <button data-mode="active">Regelt</button>
      <button data-mode="observe">Beobachtet</button>
      <button data-mode="off">Aus</button>
    </div>
  </div>

  <!-- Guard / Processes (Wide) -->
  <div class="card" style="grid-column: span 2;">
    <h2>Guard · Prozesse (Top nach RAM) <span class="stat-sub" id="guard-hinweis"></span></h2>
    <div style="max-height:300px; overflow-y:auto;">
    <table class="process-list">
      <thead>
        <tr>
          <th>PID</th>
          <th>RAM</th>
          <th>CPU</th>
          <th>Seit</th>
          <th>Klasse</th>
          <th>Befehl</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="guard-procs">
        <tr><td colspan="7" style="color: var(--text-dim);">lade…</td></tr>
      </tbody>
    </table>
    </div>
  </div>

  <div class="card">
    <h2>Pausierte Jobs</h2>
    <div id="guard-paused" class="stat-sub">keine</div>
  </div>
  <div class="card">
    <h2>Ollama-Modelle im Speicher</h2>
    <div id="guard-ollama" class="stat-sub">keine geladen</div>
  </div>
  <div class="card">
    <h2>Ereignis-Log</h2>
    <div id="guard-log" class="stat-sub" style="font-family: monospace; max-height:170px; overflow-y:auto;">–</div>
  </div>

</div>

<div class="footer">
  Mac Mini Hardware Bridge via Tunnel 18899 · Powered by Gemma-4
</div>

<script>
const API_URL = window.location.protocol.startsWith("http") ? "/api" : "http://127.0.0.1:8899/api";

function $(id) { return document.getElementById(id); }

function getColor(val, type) {
  if (val === null || val === undefined) return 'var(--border)';
  if (type === 'cpu' && val > 80) return 'var(--danger)';
  if (type === 'cpu' && val > 50) return 'var(--warning)';
  if (type === 'cpu') return 'var(--success)';
  return 'var(--accent)';
}

function updateBar(id, val, type) {
  const el = $(id);
  if (val === null) return;
  el.style.width = MathsMin(100, val) + '%';
  el.style.backgroundColor = getColor(val, type);
}

function MathsMin(a, b) { return a < b ? a : b; }

async function fetchData() {
  try {
    const response = await fetch(API_URL, { cache: 'no-store' });
    if (!response.ok) throw new Error('Network error');
    const data = await response.json();

    // Global Info
    $("status-dot").className = 'status-dot online';
    $("hostname").textContent = data.hostname || '-';
    $("zeit").textContent = data.zeit || '-';

    // CPU
    $("cpu").textContent = data.cpu_prozent ?? '-';
    $("kerne").textContent = (data.cpu_kerne || '-') + ' Cores';
    $("last").textContent = data.last || '-';
    updateBar('cpu-bar', data.cpu_prozent, 'cpu');

    // RAM
    if (data.ram) {
      $("ram-proz").textContent = data.ram.prozent ?? '-';
      $("ram-werte").textContent = (data.ram.genutzt_gb || '-') + ' GB';
      updateBar('ram-bar', data.ram.prozent, 'cpu');
    }

    // Disk
    if (data.platte) {
      $("disk-proz").textContent = data.platte.prozent ?? '-';
      $("disk-werte").textContent = (data.platte.frei_gb || '-') + ' GB';
      $("disk-gesamt").textContent = data.platte.gesamt_gb || '-';
      updateBar('disk-bar', data.platte.prozent, 'cpu');
    }

    // Thermal
    if (data.thermal) {
      $("temp-val").textContent = data.thermal.temperatures?.main || '-';
      $("thermal-limit").textContent = data.thermal.cpu_speed_limit || '-';
      updateBar('thermal-bar', data.thermal.cpu_speed_limit, 'cpu');
    }

    // Uptime
    if (data.uptime_s) {
      const d = new Date(data.uptime_s * 1000);
      $("uptime").textContent = new Date(Date.now() - (data.uptime_s * 1000)).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
      // Simplified uptime display for dashboard
      let days = Math.floor(data.uptime_s / 86400);
      let hrs = Math.floor((data.uptime_s % 86400) / 3600);
      $("uptime").textContent = (days > 0 ? days + 'd ' : '') + hrs + 'h';
    }

    // AI / Gemma
    if (data.gemma) {
      $("gemma-action").textContent = data.gemma.aktion || '-';
      $("gemma-detail").textContent = data.gemma.detail || '-';
      $("gemma-meta").textContent = [data.gemma.modell, data.gemma.projekt].filter(Boolean).join(' | ');
    }

    // Processes (Simulated/Pushed from Guard-logic in the same API)
    const tbody = $("process-body");
    if (data.procs && data.procs.length > 0) {
      tbody.innerHTML = data.procs.map(p => `
        <tr>
          <td>${p.pid}</td>
          <td style="font-weight:bold">${p.mb}MB</td>
          <td>${p.cpu}%</td>
          <td style="font-size:0.75rem; opacity:0.7">${p.cmd}</td>
        </tr>
      `).join('');
    }

  } catch (err) {
    $("status-dot").className = 'status-dot'; // offline
    console.error("Fetch error:", err);
  }
}

setInterval(fetchData, 5000);
fetchData();

/* ── mini-guard (RAM-Wächter) ── */
const GUARD_API = window.location.protocol.startsWith("http") ? "/guard/api" : "http://127.0.0.1:8850/api";
let guardTok = new URLSearchParams(location.search).get("t");
if (guardTok) { try { localStorage.setItem("guard_token", guardTok); } catch (e) {} }
else { try { guardTok = localStorage.getItem("guard_token") || ""; } catch (e) { guardTok = ""; } }
const P_TXT = { 1: "normal", 2: "Warnung", 3: "kritisch", 4: "NOTFALL" };
const P_FARB = { 1: "var(--success)", 2: "var(--warning)", 3: "#e36209", 4: "var(--danger)" };

function esc(x) {
  return String(x ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function guardApi(pfad, body) {
  const url = GUARD_API + pfad + "?t=" + encodeURIComponent(guardTok);
  return fetch(url, body ? { method: "POST", body: JSON.stringify(body) } : { cache: "no-store" })
    .then(r => { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); });
}

async function guardAct(pid, action) {
  try { await guardApi("/action", { pid, action }); } catch (e) {}
  ladeGuard();
}
async function guardMode(mode) {
  try { await guardApi("/mode", { mode }); } catch (e) {}
  ladeGuard();
}
document.querySelectorAll(".modus-schalter button").forEach(b =>
  b.onclick = () => guardMode(b.dataset.mode));

function guardOhneToken() {
  $("guard-main").textContent = "Token fehlt";
  $("guard-detail").textContent = "Einmal gemmini.gemivo.de/?t=… (Guard-Token) aufrufen, dann ist hier alles live.";
  $("guard-hinweis").textContent = "· ohne Token keine Live-Daten";
  $("guard-procs").innerHTML = '<tr><td colspan="7" class="stat-sub">Token fehlt</td></tr>';
  $("guard-paused").textContent = "–";
  $("guard-ollama").textContent = "–";
  $("guard-log").textContent = "–";
}

async function ladeGuard() {
  if (!guardTok) { guardOhneToken(); return; }
  try {
    const s = await guardApi("/status");
    const m = s.metrics || {};
    const p = m.pressure;
    $("guard-main").textContent = "Speicherdruck " + (p ?? "?") + " · " + (P_TXT[p] || "?");
    $("guard-main").style.color = P_FARB[p] || "";
    $("guard-detail").textContent = "RAM frei " + (m.free_gb ?? "?") + " GB · Swap " +
      Math.round(m.swap_mb ?? 0) + " MB · Load " +
      (m.load != null ? m.load.toFixed(1) : "?");
    $("guard-punkt").style.background = p === 1 ? "var(--success)" : (p >= 3 ? "var(--danger)" : "var(--warning)");
    document.querySelectorAll(".modus-schalter button").forEach(b =>
      b.classList.toggle("on", b.dataset.mode === s.mode));

    const pausiertPids = (s.paused || []).map(x => x.pid);
    $("guard-procs").innerHTML = (s.procs || []).map(pr => {
      const btns = pr.klasse !== "protected"
        ? "<button class='gbtn' onclick=\"guardAct(" + pr.pid + ",'pause')\">Pause</button>" +
          "<button class='gbtn stop' onclick=\"guardAct(" + pr.pid + ",'term')\">Stop</button>"
        : "";
      const weiter = pausiertPids.includes(pr.pid)
        ? "<button class='gbtn' onclick=\"guardAct(" + pr.pid + ",'resume')\">Weiter</button>" : "";
      return "<tr><td>" + pr.pid + "</td><td><b>" + pr.mb + "</b> MB</td><td>" + pr.cpu + "%</td>" +
        "<td>" + pr.etime + "</td><td>" + pr.klasse + "</td>" +
        "<td class='cmd' title='" + esc(pr.cmd) + "'>" + esc(pr.cmd) + "</td>" +
        "<td>" + weiter + btns + "</td></tr>";
    }).join("") || '<tr><td colspan="7" class="stat-sub">nichts Grosses aktiv</td></tr>';

    $("guard-paused").innerHTML = (s.paused || []).length
      ? s.paused.map(x => "PID <b>" + x.pid + "</b> · seit " + x.since + " · " +
        "<button class='gbtn' onclick=\"guardAct(" + x.pid + ",'resume')\">Jetzt fortsetzen</button>" +
        "<div class='cmd'>" + esc(x.cmd) + "</div>").join("<hr style='border-color:var(--border)'>")
      : "keine";

    $("guard-ollama").innerHTML = (s.ollama || []).length
      ? s.ollama.map(o => esc(o.name) + " (" + esc(o.size) + ")").join(" · ")
      : "keine geladen";

    $("guard-log").innerHTML = (s.events || []).slice().reverse()
      .map(e => "<div>" + esc(e) + "</div>").join("");
  } catch (e) {
    $("guard-main").textContent = "Guard nicht erreichbar";
    $("guard-main").style.color = "var(--danger)";
    $("guard-detail").textContent = e.message;
  }
}
ladeGuard();
setInterval(ladeGuard, 5000);
</script>
</body>
</html>